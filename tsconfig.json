{
  "$schema": "https://www.schemastore.org/tsconfig",

  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "lib": ["es2024"],

    "module": "NodeNext",
    "target": "ES2022",

    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "moduleResolution": "NodeNext",

    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["vitest/globals"],

    "noEmit": true
  },

  "include": ["src", "test", "**/*.test.ts"]
}
