# App

NODE_ENV=development
APP_NAME=my-api
APP_HOST=0.0.0.0
APP_PORT=3000

# Database

DB_URI=postgresql://postgres:postgres@localhost:5432/my_database

# MQTT

BROKER_URL=mqtt://localhost:1883
BROKER_CLIENT_USERNAME=
BROKER_CLIENT_PASSWORD=

# SMTP / Email

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@example.com

# JWT

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN_MIN=15

# Cookie

COOKIE_SECRET=change-me-to-another-long-random-secret
COOKIE_EXPIRES_IN_MIN=60
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS

CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Security

BCRYPT_ROUNDS=12

# Rate Limit

RATE_LIMITE_MAX_REQUEST=100